      "legitimateExplanations": [
        {
          "title": "Contact details for an existing carrier have changed.",
          "actually": "Genuine rebranding, domain migration, office relocation, or acquisition.",
          "ruleOut": "Confirm the change through the pre-existing channel, not the new one, and require confirmation from a known contact. A genuine change survives verification through the old channel; a takeover does not."
        },
        {
          "title": "Bank account name differs from the operator name.",
          "actually": "Legitimate use of a factoring company or a group treasury account, which is common in road freight.",
          "ruleOut": "Require a written assignment or factoring agreement, and verify it with the factor directly. Legitimate factoring is documented and verifiable."
        },
        {
          "title": "A primary administrator or account owner changes shortly before a movement.",
          "actually": "A genuine ownership transfer, staff change, leave cover or managed-service transition.",
          "ruleOut": "Verify the change through the previously known operator channel, record the effective date and preserve the old-to-new administrator audit trail."
        }
